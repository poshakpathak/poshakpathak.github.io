// Cloudflare Workers config for abs.poshakpathak.com: serves this folder as its own static site.
// In Cloudflare, connect this repo as a second Worker named "abs" with root directory Projects/abs.
{
  "name": "abs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "abs.poshakpathak.com", "custom_domain": true }]
}
