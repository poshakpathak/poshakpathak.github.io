// Cloudflare Workers config: serves this repo as a static site.
// No build step. Cloudflare redeploys on every push to main.
{
  "name": "poshakpathak",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
